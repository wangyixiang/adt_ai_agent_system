# Copy to `.env` before `docker compose up -d`.
#
# Real environment variables always win over this file (see
# docs/superpowers/specs/2026-10-01-deployment-and-provisioning-design.md §4.1),
# so secrets injected by the platform are never shadowed by what is written here.

# --- Database (inside the compose network the host is the service name `db`) ---
DATABASE_URL=postgres://adt:adt@db:5432/adt

# --- Listen ---
PORT=8080

# --- LLM planning (unset => no-op planner: a Workflow produces no Steps) ---
# LLM_API_KEY=
# The current DeepSeek model name is `deepseek-flash` (`deepseek-v4-pro` also
# works). `deepseek-flash` runs in thinking mode by default, which rejects the
# planner's forced tool_choice — the provider sends `thinking:{type:"disabled"}`.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_MAX_RETRIES=2

# --- Blob channel ---
# BLOB_SECRET: signing key. Unset => a fresh random secret each boot (old URLs die).
BLOB_SECRET=replace-with-a-long-random-string
# BLOB_BASE_URL: must be an address OTHER engineers can reach, or their clients
# cannot fetch uploaded evidence. Set it to the server machine's LAN address.
# BLOB_BASE_URL=http://192.168.0.10:8080
BLOB_DATA_DIR=/app/.adt/blobs
# BLOB_TOKEN_TTL_MS=900000        # 15 min, ceiling 24h
# BLOB_RETENTION_MS=2592000000    # 30 days, ceiling 365d
# BLOB_MAX_BYTES=536870912        # 512 MiB, ceiling 8 GiB

# --- KB export (both required to enable; otherwise export is `export_unavailable`) ---
# KB_ENDPOINT_URL=
# KB_TOKEN=
# KB_AUTH_HEADER=Authorization
# KB_AUTH_SCHEME=Bearer
# KB_TIMEOUT_MS=10000
# KB_MAX_RETRIES=2
